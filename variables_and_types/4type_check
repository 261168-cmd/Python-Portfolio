# File Name: type_check.py
# Importance: Check server variables and data types.

# Expected Output:
# 8080           -> int   (Normal port number)
# "8080"         -> str   (Port number in quotes)
# 99.5           -> float (Decimal value)
# "198.51.100.7" -> str   (IP address text configuration)
# 1_000          -> int   (Large number with underscore)

# Verify original data types
print("----------------------------------------")
print(type(8080))
print(type("8080"))
print(type(99.5))
print(type("198.51.100.7"))
print(type(1_000))
print("----------------------------------------")

print()  # Blank line

# Print updated values after conversion operations
print("----------------------------------------")
print(int("443"), type(int("443")))
print(str(8080), type(str(8080)))
print(float("2.5"), type(float("2.5")))
print("----------------------------------------")
