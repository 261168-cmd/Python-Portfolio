# File Name: device_card.py
# Importance: This program stores and updates network server configurations.

# ALL CAPS Constant
MAX_CONNECTIONS = 100

# Device Variables
device_name = "web-server-ppu"
device_ip = "192.0.2.20"
service = "HTTPS"
open_port = 443
Line = "=" * 35

# Print initial data with border layout
print(Line)
print("Device Name:    ", device_name)
print("IP Address:     ", device_ip)
print("Current Service:", service)
print("Port Number:    ", open_port)
print("Max Connections:", MAX_CONNECTIONS)
print(Line)

print()  # Blank line

# Update variables
service = "SSH"
open_port = 22

# Print updated values together with border layout
print(Line)
print("New configuration:", service, "on port", open_port)
print(Line)
